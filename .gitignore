# Ignore everything except Web interface, Android App source, and README
/*
!/README.md
!/.gitignore
!/sibercobanv2.html
!/android_app/

# Android build & local artifacts to ignore
android_app/.gradle/
android_app/.idea/
android_app/build/
android_app/app/build/
android_app/local.properties
android_app/*.log
android_app/*.iml
android_app/app/*.iml
android_app/app/src/main/assets/update_map.ps1
*.apk
*.aab
*.dex
*.keystore
*.jks
